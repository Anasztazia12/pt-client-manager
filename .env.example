SECRET_KEY=change-this-to-a-random-string
# For local dev you can leave DATABASE_URL unset (uses SQLite automatically).
# For MySQL, use:
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/pt_manager

# Stripe (https://dashboard.stripe.com/test/apikeys). Use sk_test_ keys for trying things out.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# gbp, eur, usd or huf
STRIPE_CURRENCY=gbp
# Public address of the app, e.g. https://example.com (optional)
PUBLIC_URL=

# 1 = sample clients and a demo banner, for a public try-out copy. Refuses sk_live_ keys.
DEMO_MODE=
